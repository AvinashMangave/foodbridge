# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/foodbridge)
# Note: If MongoDB is not running locally, the server automatically uses the built-in fallback store seamlessly!
MONGODB_URI=mongodb://localhost:27017/foodbridge

# Secret key for JWT signing
JWT_SECRET=replace_with_a_long_random_secret

# Environment
NODE_ENV=development
